DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# At least 32 random characters. Keep these server-only.
GUEST_SESSION_SECRET=replace-with-at-least-32-random-characters
ROOM_TOKEN_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GAME_PROTOCOL_VERSION=2

# Optional: App URL for production
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Persistent Render WebSocket service
NEXT_PUBLIC_WEBSOCKET_URL=wss://your-render-service.onrender.com/ws
